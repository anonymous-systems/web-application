rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /* deny everything not allowed */
    match /{document=**} {
      allow read, write: if false;
    }

    /* function to check if signed-in  */
    function isSignedIn() { return request.auth != null; }

    /* function to check if admin */
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }

    /* function to check if creator (admins are implicitly creators) */
    function isCreator() { return isAdmin() || request.auth.token.creator == true; }

    /* a reaction holds only a type, from a fixed vocabulary; counts are
       maintained by a trigger and must never be written by a client */
    function isValidReaction() {
      return request.resource.data.keys().hasOnly(['type'])
        && request.resource.data.type in ['like', 'dislike'];
    }

    /* a report opens in the 'open' state; only a moderator may move it on */
    function isValidReport() {
      return request.resource.data.keys().hasOnly(['reason', 'detail', 'status', 'createdAt'])
        && request.resource.data.reason in ['spam', 'harassment', 'hate', 'misinformation', 'other']
        && request.resource.data.status == 'open';
    }

    /* stories collection */
    match /stories/{storyID} {
      /* function to get role of signed in user */
      function getRole(rsc) { return rsc.data.roles[request.auth.uid]; }

      /* function to tell if role story has provided roles */
      function isOneOfRoles(rsc, array) { return isSignedIn() && (getRole(rsc) in array); }

      /* function to tell if story is publicly visible (published + public) */
      function publicStory(rsc) { return rsc.data.visibility == 'public' && rsc.data.status == 'published'; }

      /* function to validate new story owner */
      function isValidNewStory() { return isOneOfRoles(request.resource, ["owner"]) && request.resource.data.user == /databases/$(database)/documents/users/$(request.auth.uid); }

      /* function to tell if story comments are enabled */
      function commentsEnabled(rsc) { return rsc.data.get('allowComments', true); }

      allow create: if isCreator() && isValidNewStory();
      allow update: if isOneOfRoles(resource, ['owner', 'writer']);
      allow delete: if isOneOfRoles(resource, ['owner']);
      allow read: if isOneOfRoles(resource, ['owner', 'writer', 'reader']) || publicStory(resource) || isAdmin() || resource == null;

      /* story comments collection */
      match /comments/{commentID} {
        allow create, update: if request.resource.data.user == /databases/$(database)/documents/users/$(request.auth.uid) && publicStory(get(/databases/$(database)/documents/stories/$(storyID))) && commentsEnabled(get(/databases/$(database)/documents/stories/$(storyID)));
        allow read: if publicStory(get(/databases/$(database)/documents/stories/$(storyID))) && commentsEnabled(get(/databases/$(database)/documents/stories/$(storyID))) || isOneOfRoles(get(/databases/$(database)/documents/stories/$(storyID)), ["owner", "writer", "reader"]);

        /* reactions keyed by reactor uid, so a user cannot react twice and
           writing someone else's reaction is structurally impossible */
        match /reactions/{reactorUID} {
          allow read: if publicStory(get(/databases/$(database)/documents/stories/$(storyID)));
          allow delete: if request.auth.uid == reactorUID;
          allow create, update: if request.auth.uid == reactorUID && isValidReaction() && publicStory(get(/databases/$(database)/documents/stories/$(storyID))) && commentsEnabled(get(/databases/$(database)/documents/stories/$(storyID)));
        }

        /* reports keyed by reporter uid: one report per person per comment, and
           filing one in someone else's name is structurally impossible. Only a
           moderator can read the pile or move a report on. */
        match /reports/{reporterUID} {
          allow read: if isAdmin() || request.auth.uid == reporterUID;
          allow create: if request.auth.uid == reporterUID && isValidReport() && publicStory(get(/databases/$(database)/documents/stories/$(storyID)));
          allow update, delete: if isAdmin();
        }
      }
    }

    /* categories collection */
    match /categories/{categoryID} {
      allow read;
      allow create, update: if isCreator();
      allow delete: if isAdmin();
    }

    /* tags collection */
    match /tags/{tagID} {
      allow read;
      allow create, update: if isCreator();
      allow delete: if isAdmin();
    }

    /* technologies collection */
    match /technologies/{technologyID} {
      allow read;
      allow create, update: if isCreator();
      allow delete: if isAdmin();
    }

    /* comments collection group */
    match /{path=**}/comments/{commentID} {
      allow read: if isAdmin();
    }

    /* users collection */
    match /users/{userUID} {
      allow read;
      allow write: if request.auth.uid == userUID || isAdmin();
    }

    /*
      usernames collection: the username -> uid index the onboarding function
      writes, used to resolve a public profile URL.

      `get` only, never `list`. A single document answers "who is this
      username?", which is all the profile page asks; allowing `list` would turn
      the index into a downloadable directory of every username on the site.

      Writes stay closed to clients. The index and the profile must be created
      together or a username is reserved with nothing behind it, so only the
      onboarding function writes here — it uses the Admin SDK in a transaction
      and bypasses these rules entirely.
    */
    match /usernames/{username} {
      allow get;
    }
    
    /* projects collection */
    match /projects/{projectID} {
      /* function to get role of signed in user */
      function getRole(rsc) { return rsc.data.roles[request.auth.uid]; }

      /* function to tell if project has provided roles */
      function isOneOfRoles(rsc, array) { return isSignedIn() && (getRole(rsc) in array); }

      /* function to tell if project is publicly visible (published + public) */
      function publicProject(rsc) { return rsc.data.visibility == 'public' && rsc.data.status == 'published'; }

      /* function to validate new project owner */
      function isValidNewProject() { return isOneOfRoles(request.resource, ["owner"]) && request.resource.data.user == /databases/$(database)/documents/users/$(request.auth.uid); }

      /* function to tell if project comments are enabled */
      function commentsEnabled(rsc) { return rsc.data.get('allowComments', true); }

      allow create: if isCreator() && isValidNewProject();
      allow update: if isOneOfRoles(resource, ['owner', 'writer']);
      allow delete: if isOneOfRoles(resource, ['owner']);
      allow read: if isOneOfRoles(resource, ['owner', 'writer', 'reader']) || publicProject(resource) || isAdmin() || resource == null;

      /* project comments collection */
      match /comments/{commentID} {
        allow create, update: if request.resource.data.user == /databases/$(database)/documents/users/$(request.auth.uid) && publicProject(get(/databases/$(database)/documents/projects/$(projectID))) && commentsEnabled(get(/databases/$(database)/documents/projects/$(projectID)));
        allow read: if publicProject(get(/databases/$(database)/documents/projects/$(projectID))) && commentsEnabled(get(/databases/$(database)/documents/projects/$(projectID))) || isOneOfRoles(get(/databases/$(database)/documents/projects/$(projectID)), ["owner", "writer", "reader"]);

        /* reactions keyed by reactor uid, so a user cannot react twice and
           writing someone else's reaction is structurally impossible */
        match /reactions/{reactorUID} {
          allow read: if publicProject(get(/databases/$(database)/documents/projects/$(projectID)));
          allow delete: if request.auth.uid == reactorUID;
          allow create, update: if request.auth.uid == reactorUID && isValidReaction() && publicProject(get(/databases/$(database)/documents/projects/$(projectID))) && commentsEnabled(get(/databases/$(database)/documents/projects/$(projectID)));
        }

        /* reports keyed by reporter uid: one report per person per comment, and
           filing one in someone else's name is structurally impossible. Only a
           moderator can read the pile or move a report on. */
        match /reports/{reporterUID} {
          allow read: if isAdmin() || request.auth.uid == reporterUID;
          allow create: if request.auth.uid == reporterUID && isValidReport() && publicProject(get(/databases/$(database)/documents/projects/$(projectID)));
          allow update, delete: if isAdmin();
        }
      }
    }
  }
}
